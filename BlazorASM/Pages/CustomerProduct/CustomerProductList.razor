@page "/customer/products"
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@using System.Net.Http.Headers
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims

<!-- Navbar -->
<!-- Banner -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="carousel slide" id="carouselExampleControls" data-bs-ride="carousel">
                <!-- Carousel items here -->
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm -->
<div class="container">
    <h3 class="mb-4 text-primary">🛍 Danh sách sản phẩm</h3>

    <!-- Tìm kiếm và lọc -->
    <div class="row mb-3">
        <div class="col-md-3">
            <input class="form-control" @bind="searchTerm" placeholder="🔍 Tìm theo tên sản phẩm..." />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="selectedCategoryId">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryID">@category.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input class="form-control" type="number" @bind="minPrice" placeholder="Giá từ" />
        </div>
        <div class="col-md-2">
            <input class="form-control" type="number" @bind="maxPrice" placeholder="Giá đến" />
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="sortOrder">
                <option value="asc">Sắp xếp: Tăng dần</option>
                <option value="desc">Sắp xếp: Giảm dần</option>
            </select>
        </div>
        <div class="col-md-2 d-flex">
            <button class="btn btn-primary me-2" @onclick="ApplyFilters">Lọc</button>
            <button class="btn btn-secondary" @onclick="ClearFilters">Xoá lọc</button>
        </div>
    </div>

    @if (pagedProducts == null || products == null)
    {
        <p>Đang tải sản phẩm...</p>
    }
    else if (products.Count == 0)
    {
        <p>Không có sản phẩm nào.</p>
    }
    else
    {
        <div class="row">
            @foreach (var product in pagedProducts)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.Image))
                        {
                            <img src=@($"https://localhost:7032/{product.Image}") class="card-img-top" style="height:200px; object-fit:cover" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light text-center" style="height:200px; line-height:200px;">Không có ảnh</div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text fw-bold">@product.Price.ToString("N0") ₫</p>
                            <button class="btn btn-primary mt-auto w-100" @onclick="() => AddToCart(product.ProductID)">➕ Thêm vào giỏ</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                @if (totalPages > 1)
                {
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">«</button>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">»</button>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p>&copy; 2025 BlazorASM. Tất cả quyền được bảo lưu.</p>
</footer>

@code {
    List<ProductDto> products = new();
    List<ProductDto> pagedProducts = new();
    List<Category> categories = new();

    int currentPage = 1;
    int pageSize = 8;
    int totalPages = 1;
    string? searchTerm;
    int? selectedCategoryId;
    decimal? minPrice;
    decimal? maxPrice;
    string sortOrder = "asc"; // Mặc định là "asc"

    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load danh mục
            categories = await Http.GetFromJsonAsync<List<Category>>("api/categories");

            // Load sản phẩm theo filter (nếu có)
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi khi load danh sách sản phẩm: " + ex.Message);
        }
    }

    async Task LoadProducts()
    {
        var url = $"api/products/search?searchTerm={searchTerm}&categoryId={selectedCategoryId}&minPrice={minPrice}&maxPrice={maxPrice}&sortOrder={sortOrder}";
        var result = await Http.GetFromJsonAsync<List<ProductDto>>(url);
        products = result ?? new();
        totalPages = (int)Math.Ceiling(products.Count / (double)pageSize);
        currentPage = 1;
        UpdatePagedProducts();
    }

    void UpdatePagedProducts()
    {
        pagedProducts = products
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagedProducts();
        }
    }

    async Task ApplyFilters()
    {
        await LoadProducts();
    }

    async Task ClearFilters()
    {
        searchTerm = null;
        selectedCategoryId = null;
        minPrice = null;
        maxPrice = null;
        sortOrder = "asc"; // Reset lại sortOrder
        await LoadProducts();
    }

    async Task AddToCart(int productId)
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        var customerId = ParseUserIdFromJwt(token);

        var request = new
        {
            CustomerId = customerId,
            ProductId = productId,
            Quantity = 1
        };

        var response = await Http.PostAsJsonAsync("api/cart/add", request);
        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Thêm vào giỏ hàng thành công");
        }
        else
        {
            Console.WriteLine("Thêm thất bại");
        }
    }

    string ParseUserIdFromJwt(string token)
    {
        var jwt = new JwtSecurityTokenHandler().ReadJwtToken(token);
        return jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    public class ProductDto
    {
        public int ProductID { get; set; }
        public string ProductName { get; set; }
        public decimal Price { get; set; }
        public string? Image { get; set; }
    }

    public class Category
    {
        public int CategoryID { get; set; }
        public string CategoryName { get; set; }
    }
}
