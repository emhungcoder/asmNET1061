@page "/manager/ordermanager"
@inject IOrderService OrderService
@inject NavigationManager NavigationManager

<h3 class="text-2xl font-bold mb-4">Quản lý đơn hàng</h3>

<div class="flex gap-4 mb-4">
    <input class="border rounded p-2 w-1/3" placeholder="Tìm theo mã hoặc tên khách hàng" @bind="searchKeyword" @bind:event="oninput" />
    <select class="border rounded p-2" @bind="selectedStatus">
        <option value="">Tất cả trạng thái</option>
        <option>Đang xử lý</option>
        <option>Đang giao</option>
        <option>Hoàn tất</option>
        <option>Đã hủy</option>
    </select>
    <button class="bg-blue-500 text-white px-4 py-2 rounded" @onclick="LoadOrders">Tìm kiếm</button>
</div>

@if (orders == null)
{
    <p>Đang tải...</p>
}
else if (orders.Count == 0)
{
    <p>Không có đơn hàng nào.</p>
}
else
{
    <table class="table-auto w-full border">
        <thead>
            <tr class="bg-gray-200">
                <th class="px-4 py-2 border">Mã đơn</th>
                <th class="px-4 py-2 border">Khách hàng</th>
                <th class="px-4 py-2 border">Ngày đặt</th>
                <th class="px-4 py-2 border">Tổng tiền</th>
                <th class="px-4 py-2 border">Trạng thái</th>
                <th class="px-4 py-2 border">Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td class="border px-4 py-2">@order.OrderId</td>
                    <td class="border px-4 py-2">@order.Customer?.FullName</td>
                    <td class="border px-4 py-2">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td class="border px-4 py-2">@order.TotalAmount.ToString("C0")</td>
                    <td class="border px-4 py-2">
                        <div class="flex flex-col gap-2">
                            <select @bind="order.Status" class="border rounded p-2">
                                <option>Đang xử lý</option>
                                <option>Đã xác nhận</option>
                                <option>Đang giao</option>
                                <option>Đã giao</option>
                                <option>Đã hủy</option>
                            </select>
                            <button class="bg-green-500 text-white px-2 py-1 rounded" @onclick="() => UpdateOrderStatus(order.OrderId, order.Status)">
                                Cập nhật
                            </button>
                        </div>
                    </td>
                    <td class="border px-4 py-2">
                        <button class="text-blue-600 underline" @onclick="() => ViewDetails(order.OrderId)">Xem</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string? searchKeyword;
    private string? selectedStatus;
    private List<Order> orders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        orders = await OrderService.GetOrdersAsync(selectedStatus, searchKeyword);

        foreach (var order in orders)
        {
            if (string.IsNullOrWhiteSpace(order.Status))
            {
                order.Status = "Đang xử lý";
            }
        }
    }

    private void ViewDetails(int id)
    {
        NavigationManager.NavigateTo($"/manager/orderdetail/{id}");
    }

    private async Task UpdateOrderStatus(int orderId, string status)
    {
        await OrderService.UpdateOrderStatusAsync(orderId, status);
        await LoadOrders(); 
    }
}
