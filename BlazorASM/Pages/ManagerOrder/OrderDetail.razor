@page "/manager/orderdetail/{orderId:int}"
@using ASM.Client.Models
@inject IOrderService OrderService
@inject NavigationManager Navigation

<h2 class="text-2xl font-semibold mb-4">Chi tiết đơn hàng</h2>

@if (isLoading)
{
    <p>Đang tải dữ liệu...</p>
}
else if (order != null)
{
    <div class="mb-4">
        <p><strong>Mã đơn hàng:</strong> @order.OrderId</p>
        <p><strong>Khách hàng:</strong> @order.Customer?.FullName</p>
        <p><strong>Ngày đặt:</strong> @order.OrderDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Trạng thái:</strong> @order.Status</p>
        <p><strong>Tổng tiền:</strong> @order.TotalAmount.ToString("N0") VND</p>
    </div>

    <h3 class="text-xl font-semibold mb-2">Danh sách sản phẩm</h3>
    <table class="table-auto w-full border border-gray-300">
        <thead class="bg-gray-100">
            <tr>
                <th class="border px-4 py-2">Tên sản phẩm</th>
                <th class="border px-4 py-2">Số lượng</th>
                <th class="border px-4 py-2">Đơn giá</th>
                <th class="border px-4 py-2">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in order.OrderDetails)
            {
                <tr>
                    <td class="border px-4 py-2">@item.Product?.ProductName</td>
                    <td class="border px-4 py-2">@item.Quantity</td>
                    <td class="border px-4 py-2">@item.UnitPrice.ToString("N0")</td>
                    <td class="border px-4 py-2">@(item.Quantity * item.UnitPrice).ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-red-600">Không tìm thấy đơn hàng.</p>
}

<button @onclick="GoBack" class="mt-4 bg-gray-500 text-white px-4 py-2 rounded">Quay lại</button>

@code {
    [Parameter] public int orderId { get; set; }

    private Order? order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetOrderByIdAsync(orderId);
        isLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/manager/ordermanager");
    }
}